# cyberprompt configuration (sourced by the hook)
# MODEL/EFFORT: which model+effort runs the optimization pass. Pinned so it
# never silently follows the session's effortLevel.
#   Harness verdict 2026-07-29 (28 fixtures x 3 variants = 84 calls, 5 failed:
#   4 sonnet-low, 1 sonnet-med). On calls that returned, all three variants kept
#   100% of must-preserve constraints and neither injection fixture landed.
#   sonnet-5 medium and opus-5 high tie at p50 ~15s; opus holds the tighter tail
#   (p95 23s vs 41s) and made 0 must-not-add slips vs sonnet-med's 1 (a negated
#   mention of a corrected-away filename). sonnet-med stays default on price, not
#   on winning. sonnet-5 low leaked background context into a rewrite — avoid.
#   Disposition/speech-act scores are excluded from this verdict: all variants
#   fall below a trivial always-rewrite baseline (fixture-labeling debt).
#   Reproduce: harness/run.sh. Strictest: MODEL=claude-opus-5 EFFORT=high
MODEL=claude-sonnet-5
EFFORT=medium
# Prompts shorter than this many characters pass through unoptimized.
MIN_CHARS=80
# Seconds the hook waits for the optimizer call before failing open. Keep this
# below the hook-level timeout registered in hooks.json/settings.json (200),
# or the harness kills the hook before it can fail open with a message.
OPT_TIMEOUT=180
# How many recent operator prompts the optimizer sees as background context for
# resolving references ("the chief", "do it again"), alongside the assistant's
# latest text reply. Research-sized default (harness verdict + .omc/research):
# raise cautiously — stale context pollutes rewrites. 0 = stateless, no
# transcript read.
HISTORY_TURNS=4
# Optional: swap the bundled claude-5 skill for your own prompting guide.
# Default resolution: the plugin's own copy (CLAUDE_PLUGIN_ROOT/skills/claude-5);
# manual installs read the copy install.sh seeds to ~/.claude/skills/claude-5.
#CLAUDE5_SKILL=/path/to/claude-5
